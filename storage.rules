rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function teacher() {
      return signedIn() && request.auth.token.email == 'mostafakareem978@gmail.com';
    }

    // Teacher media/materials: only the fixed teacher account can upload,
    // while authenticated users can read published assets through their URLs.
    match /teacher-files/{uid}/{allPaths=**} {
      allow write: if teacher() && request.auth.uid == uid;
      allow read: if signedIn();
    }

    // Student assignment submissions remain available for authenticated users.
    match /student-submissions/{uid}/{allPaths=**} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn();
    }

    match /{allPaths=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
