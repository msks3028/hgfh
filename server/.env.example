# PostgreSQL (Railway PostgreSQL provides DATABASE_URL automatically when linked)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=true

# Session security - generate a long random secret
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Railway supplies PORT automatically
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Vercel frontend
FRONTEND_URL=https://hgfh-zdwk.vercel.app
FRONTEND_URLS=https://hgfh-zdwk.vercel.app,https://hgfh-two.vercel.app,http://localhost:5173
ALLOW_VERCEL_PREVIEWS=true
COOKIE_SAMESITE=none

# Firebase Web API key
FIREBASE_WEB_API_KEY=AIzaSyAUAl8zBcZTi_hC3JeGXcMoWXc3ew0A6Mc
TEACHER_EMAIL=your-teacher-email@example.com

# Temporary Cloudflare testing only
ALLOW_TRYCLOUDFLARE=false
